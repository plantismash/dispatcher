usage = "%prog [options]"
version = "%prog 0.0.2"

NCBI_URL = 'https://eutils.ncbi.nlm.nih.gov/entrez/eutils/efetch.fcgi'
error_patterns = (
    'Error reading from remote server',
    'Bad gateway',
    'Cannot process ID list',
    'server is temporarily unable to service your request',
    'Service unavailable',
    'Server Error',
    'ID list is empty',
    'Resource temporarily unavailable',
)


class JobFailedError(Exception):
    pass


def main():
    """Parse the command line, set up the database, start the main loop"""

    default_queue = os.getenv('AS_QUEUE', "redis://localhost:6379/0")

    parser = argparse.ArgumentParser(description="Dispatcher for antiSMASH job queue")
    parser.add_argument('-q', '--queue', dest="queue",
                        help=f"URI of the database containing the job queue (default: {default_queue})",
                        default=default_queue)
    parser.add_argument('-w', '--workdir', dest="workdir",
                        help="Path to working directory that contains the uploaded sequences",
                        default=path.abspath("upload"))
    parser.add_argument('-c', '--cpus', dest="cpus", type=int,
                        help="Number of CPUs to use", default=1)    
    parser.add_argument('-n', '--name', dest="name",
                        help="Name of this dispatcher process", default="runSMASH")
    parser.add_argument('-s', '--statusdir', dest="statusdir",
                        default="/tmp/antismash_status",
                        help="Directory to keep job status files in")
    parser.add_argument('-t', '--timeout', dest="timeout", type=int,
                        default=86400,
                        help="Kill jobs after a certain number of seconds (default: 86400 (1 day))")
    parser.add_argument('--once', dest="once", action="store_true",
                        help="Only run the dispatcher once")
    parser.add_argument('--script', dest="script",
                        default="run_antismash.py",
                        help="Destination of the script to run plantiSMASH backend")
    parser.add_argument('--legacy-script', dest="legacy_script",
                        default="run_legacy_antismash",
                        help="antiSMASH run script for version 3 jobs")
    parser.add_argument('-d', '--debug', dest="debug", action="store_true",
                        help="Run script in debug mode")
    parser.add_argument('--minimal', dest="minimal", action="store_true",
                        help="Only run minimal antiSMASH analysis")
    parser.add_argument('--container', dest="container", action="store_true",
                        help="Run script in a container, use in-container paths")
    parser.add_argument('--direct', dest="container", action="store_false",
                        help="Run script outside a container, use real paths")

    parser.set_defaults(container=True)
    options = parser.parse_args()

    # Set up logging
    logging.basicConfig(level=logging.INFO, format='%(asctime)s %(levelname)s: %(message)s')

    # Ensure workdir exists
    if not path.exists(options.workdir):
        print(f"📂 Creating work directory: {options.workdir}")
        os.makedirs(options.workdir, exist_ok=True)

    # Ensure statusdir exists
    if not path.exists(options.statusdir):
        print(f"📂 Creating status directory: {options.statusdir}")
        os.makedirs(options.statusdir, exist_ok=True)

    # Connect to Redis
    redis_store = get_storage(options.queue, timeout=7)
    options.redis_store = redis_store
    options.num_retries = 0

    try:
        options.r_name = f'control:{options.name}'
        res = redis_store.hgetall(options.r_name)

        # Convert Redis byte keys and values to strings
        res = {k.decode() if k else k: v.decode() if v else v for k, v in res.items()}
        print(f"🔍 Redis Control Data: {res}")

        # Initialize control object
        control = Control(**res) if res else Control(options.name)
        control.running = True
        control.status = "idle"

        # Store control status in Redis
        for key, value in control.__dict__.items():
            redis_store.hset(options.r_name, str(key), str(value))

        # Run dispatcher loop
        run(options)

    except Exception as err:
        logging.error("Caught exception: %s (%s)", err, type(err))
        raise
    finally:
        redis_store.delete(options.r_name)


def run(options):
    """Run the dispatcher process"""
    redis_store = options.redis_store
    queue_name = 'jobs:queued'

    while True:
        try:
            # Fetch control data
            rd_store = redis_store.hgetall(options.r_name)
            rd_store = {k.decode() if isinstance(k, bytes) else k: 
                        (v.decode() if isinstance(v, bytes) else v) 
                        for k, v in rd_store.items()}

            control = Control(**rd_store)

            if control.stop_scheduled == 'True':
                logging.info("Stopping dispatcher...")
                control.stop_scheduled = False
                redis_store.hset(options.r_name, 'stop_scheduled', control.stop_scheduled)
                return

            # Check current queue state BEFORE popping
            jobs = redis_store.lrange(queue_name, 0, -1)
            decoded_jobs = [j.decode() if isinstance(j, bytes) else j for j in jobs]
            logging.info("Queue length: %d", len(decoded_jobs))
            logging.info("Jobs in queue: %s", ", ".join(decoded_jobs) if decoded_jobs else "None")

            # Now try to pop a job (this will block up to 5 seconds)
            uid = redis_store.brpoplpush(queue_name, f'{options.name}:queued', 5)

            if uid is None:
                logging.info("No job picked up in this cycle.")
                time.sleep(5)
                continue

            uid = uid.decode() if isinstance(uid, bytes) else uid
            logging.info("Picked up job: %s → moved to '%s:queued'", uid, options.name)

            # Fetch job data
            res = redis_store.hgetall(f'job:{uid}')
            res = {k.decode() if isinstance(k, bytes) else k:
                   v.decode() if isinstance(v, bytes) else v
                   for k, v in res.items()}

            if not res:
                logging.warning("Job data not found for UID: %s", uid)
                continue

            if 'last_changed' in res:
                try:
                    res['last_changed'] = datetime.fromisoformat(res['last_changed']).replace(tzinfo=None)
                except ValueError:
                    res['last_changed'] = datetime.now(timezone.utc)

            job = Job(**res)
            job.dispatcher = options.name

            dispatch(job, options)
            redis_store.hset(options.r_name, 'status', 'idle')

            if options.once:
                break

        except TimeoutError as err:
            logging.error(err)
            if options.num_retries < 5:
                options.num_retries += 1
                time.sleep(5)
                continue
            logging.error('Maximum retries exceeded, shutting down')
            raise
        except Exception as err:
            logging.error("Unexpected error: %s, %s", err, type(err))
            raise

def dispatch(job, options):
    """Dispatch a specified job"""
    now = datetime.utcnow()
    logging.info("%s: Dispatching %s", options.name, job)
    redis_store = options.redis_store
    job_id = f'job:{job.uid}'

    # Move job from queued to running
    redis_store.rpoplpush(f'{options.name}:queued', 'jobs:running')
    redis_store.hset(job_id, 'last_changed', now.isoformat())
    redis_store.hset(job_id, 'status', 'running')

    try:
        # Handle NCBI download if specified
        if job.download:
            download_from_ncbi(job, options)
            redis_store.hset(job_id, 'filename', job.filename)

        # Execute the job command
        run_command(job, options)
        job.status = 'done'
        logging.info("%s: Job %s completed successfully", options.name, job.uid)

    except JobFailedError as err:
        msg, rcode = err.args[0]
        job.status = f"failed: {msg}"
        logging.error("%s: Job %s failed with error: %s", options.name, job.uid, msg)

        # Send error mail for specific job types and error codes
        if rcode != 2 or job.jobtype not in ("antismash", "test1"):
            try:
                send_error_mail(job)
            except Exception as mail_err:
                logging.error("Sending error mail failed: %s, %s", mail_err, type(mail_err))

    # Finalize job status
    job.last_changed = datetime.utcnow()
    redis_store.hset(job_id, 'status', job.status)
    redis_store.hset(job_id, 'last_changed', job.last_changed.isoformat())
    redis_store.lrem('jobs:running', 0, job.uid)
    redis_store.lpush('jobs:completed', job.uid)

    # Update job statistics
    timestamps = (
        job.last_changed.strftime("%Y-%m-%d"),  # daily stats
        job.last_changed.strftime("%Y-CW%U"),   # weekly stats
        job.last_changed.strftime("%Y-%m"),     # monthly stats
    )
    for timestamp in timestamps:
        redis_store.hset(f'jobs:{timestamp}', job.uid, job.status.split(":")[0])

    # Send completion mail
    try:
        send_mail(job)
    except Exception as mail_err:
        logging.error("Sending completion mail failed: %s, %s", mail_err, type(mail_err))

    # Clean up status file
    delete_statusfile(job, options)
    logging.info("%s: Done with %s", options.name, job)



def run_command(job, options):
    """actually run the command"""
    args, cwd = get_commandline_for_job(job, options)
    proc = sp.Popen(args, cwd=cwd, stderr=sp.PIPE)
    try:
        timeout = options.timeout
        if options.container:
            timeout = None
        stdout_data, stderr_data = proc.communicate(timeout=timeout)
    except sp.TimeoutExpired:
        kill_proc_and_all_children(proc)
        raise JobFailedError(("Runtime exceeded limit of {} seconds".format(options.timeout), 9))

    if proc.returncode > 0:
        raise JobFailedError((str(stderr_data), proc.returncode))


def get_commandline_for_job(job, options):
    cwd = path.join(options.workdir, job.uid)

    if job.jobtype == 'antismash4':
        return get_antismash4_commandline(job, options), cwd
    elif job.jobtype == 'antismash3':
        return get_antismash3_commandline(job, options), cwd
    elif job.jobtype == 'plantismash':
        return get_plantismash_commandline(job, options), cwd
    else:
        raise JobFailedError(("Don't know how to run %r jobs" % job.jobtype, -1))


def get_antismash3_commandline(job, options):
    """Get commandline for antismash3 command"""
    args = [
        options.legacy_script,
        job.filename,
        options.workdir,
        '--cpus', str(options.cpus)
    ]

    if options.debug:
        args.append('--debug')
    else:
        args.append('--verbose')

    if job.smcogs:
        args.append('--smcogs')
    if job.asf:
        args.append('--asf')

    args.append('--disable_subgroup')

    if job.clusterblast:
        args.append('--clusterblast')
    if job.subclusterblast:
        args.append('--subclusterblast')
    if job.knownclusterblast:
        args.append('--knownclusterblast')

    if job.fullhmmer:
        args.append('--full-hmmer')

    if job.from_pos > 0:
        args += ['--from', str(job.from_pos)]
    if job.to_pos > 0:
        args += ['--to', str(job.to_pos)]

    if job.all_orfs:
        args.append('--all-orfs')

    if job.inclusive:
        args.append('--inclusive')
        args += [
            '--cf_cdsnr', str(job.cf_cdsnr),
            '--cf_npfams', str(job.cf_npfams),
            '--cf_threshold', str(job.cf_threshold)
        ]

    if job.genefinder != '':
        args += ['--genefinding', job.genefinder.replace('_', '-')]

    args += ['--input-type', job.molecule]
    args += ['--statusfile', path.join(options.statusdir, job.uid)]
    args += ['--logfile', path.join(path.join(options.workdir, job.uid), "%s.log" % job.uid)]

    output_dir = path.abspath(path.join(options.workdir, job.uid))
    args += ['--outputfolder', output_dir]

    return args


